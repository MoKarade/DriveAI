{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd app && npm ci && npm run build",
  "outputDirectory": "app/dist",
  "framework": null,
  "installCommand": "true",
  "functions": {
    "api/hub/summary.ts": { "maxDuration": 20 },
    "api/mcp/index.ts": { "maxDuration": 90 }
  },
  "rewrites": [
    { "source": "/.well-known/oauth-authorization-server", "destination": "/api/mcp/meta?type=as" },
    { "source": "/.well-known/oauth-authorization-server/:suffixe*", "destination": "/api/mcp/meta?type=as" },
    { "source": "/.well-known/oauth-protected-resource", "destination": "/api/mcp/meta?type=pr" },
    { "source": "/.well-known/oauth-protected-resource/:suffixe*", "destination": "/api/mcp/meta?type=pr" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://sheets.googleapis.com https://www.googleapis.com https://accounts.google.com; frame-src https://accounts.google.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://accounts.google.com; object-src 'none'"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
